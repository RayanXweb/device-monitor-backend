# ============================================
# DEVICE MONITOR BACKEND - ENVIRONMENT VARIABLES
# ============================================
# Complete configuration for production deployment
# Version: 3.0.0
# Last Updated: 2024
# ============================================

# --------------------------------------------
# SERVER CONFIGURATION
# --------------------------------------------
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
API_VERSION=v1
API_PREFIX=/api
APP_NAME=Device Monitor Pro
APP_URL=https://your-domain.com
BACKEND_URL=https://api.your-domain.com

# --------------------------------------------
# FRONTEND URL (CORS)
# --------------------------------------------
FRONTEND_URL=https://your-frontend.vercel.app
FRONTEND_URL_LOCAL=http://localhost:3000
FRONTEND_URL_STAGING=https://staging.your-frontend.vercel.app
CORS_ORIGIN=https://your-frontend.vercel.app,http://localhost:3000,http://localhost:3001
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-API-Key,X-Device-Id,X-Request-ID
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# --------------------------------------------
# DATABASE CONFIGURATION (MongoDB Atlas)
# --------------------------------------------
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/devicemonitor?retryWrites=true&w=majority&appName=DeviceMonitor
MONGODB_URI_READONLY=mongodb+srv://username:password@cluster.mongodb.net/devicemonitor?retryWrites=true&readPreference=secondaryPreferred
MONGODB_DB_NAME=device_monitor_prod
MONGODB_USER=your_db_user
MONGODB_PASSWORD=your_db_password
MONGODB_HOST=cluster.mongodb.net
MONGODB_PORT=27017
MONGODB_OPTIONS=retryWrites=true&w=majority
MONGODB_POOL_SIZE=10
MONGODB_SOCKET_TIMEOUT=45000
MONGODB_CONNECT_TIMEOUT=30000
MONGODB_SERVER_SELECTION_TIMEOUT=5000
MONGODB_HEARTBEAT_FREQUENCY=10000
MONGODB_MIN_POOL_SIZE=2
MONGODB_MAX_POOL_SIZE=20

# --------------------------------------------
# REDIS CONFIGURATION (Upstash or Redis Cloud)
# --------------------------------------------
REDIS_URL=redis://:password@redis-host:6379
REDIS_HOST=your-redis-host.redis.cache.windows.net
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0
REDIS_TLS=true
REDIS_KEY_PREFIX=device_monitor:
REDIS_CONNECT_TIMEOUT=10000
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=1000
REDIS_SESSION_TTL=86400
REDIS_CACHE_TTL=3600

# --------------------------------------------
# JWT AUTHENTICATION
# --------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-change-this
JWT_REFRESH_SECRET=your-refresh-secret-key-minimum-32-characters-change-this
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_DEVICE_EXPIRY=30d
JWT_ALGORITHM=HS256
JWT_ISSUER=device-monitor-api
JWT_AUDIENCE=device-monitor-users

# --------------------------------------------
# ENCRYPTION
# --------------------------------------------
AES_SECRET_KEY=your-32-character-aes-encryption-key-here
AES_IV=your-16-character-iv
BCRYPT_ROUNDS=12
CSRF_SECRET=your-csrf-secret-key-minimum-32-characters
ENCRYPTION_ALGORITHM=aes-256-gcm

# --------------------------------------------
# RATE LIMITING
# --------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS_LOGIN=300000
RATE_LIMIT_MAX_REQUESTS_LOGIN=5
RATE_LIMIT_WINDOW_MS_API=60000
RATE_LIMIT_MAX_REQUESTS_API=50
RATE_LIMIT_WINDOW_MS_WS=60000
RATE_LIMIT_MAX_CONNECTIONS_WS=10
RATE_LIMIT_SKIP_SUCCESSFUL=true

# --------------------------------------------
# FIREBASE CONFIGURATION (FCM for Push Notifications)
# --------------------------------------------
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour Private Key Here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FCM_API_KEY=your-fcm-api-key
FCM_SENDER_ID=your-sender-id

# --------------------------------------------
# EMAIL CONFIGURATION (SMTP)
# --------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_SECURE=false
SMTP_FROM=noreply@devicemonitor.com
SMTP_FROM_NAME=Device Monitor Pro
SMTP_REPLY_TO=support@devicemonitor.com
SMTP_POOL=true
SMTP_MAX_CONNECTIONS=5
SMTP_RATE_LIMIT=10

# Alternative Email Providers
# SendGrid
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@devicemonitor.com

# Mailgun
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=your-domain.com
MAILGUN_FROM_EMAIL=noreply@your-domain.com

# AWS SES
AWS_SES_ACCESS_KEY=your-aws-access-key
AWS_SES_SECRET_KEY=your-aws-secret-key
AWS_SES_REGION=us-east-1
AWS_SES_FROM_EMAIL=noreply@your-domain.com

# --------------------------------------------
# TWILIO CONFIGURATION (SMS & Calls)
# --------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY=your-twilio-api-key
TWILIO_API_SECRET=your-twilio-api-secret

# --------------------------------------------
# WEBHOOKS & INTEGRATIONS
# --------------------------------------------
# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX
SLACK_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL=#alerts

# Discord
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token
DISCORD_BOT_TOKEN=your-discord-bot-token

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# GitHub
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# --------------------------------------------
# FILE STORAGE
# --------------------------------------------
# Local Storage
UPLOAD_DIR=uploads
TEMP_DIR=temp
EXPORT_DIR=exports
MAX_FILE_SIZE=52428800
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,image/gif,video/mp4,video/mpeg,audio/mpeg,audio/mp3,application/pdf,application/json,text/plain

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=device-monitor-uploads
AWS_S3_BUCKET_BACKUP=device-monitor-backups
AWS_CLOUDFRONT_URL=https://your-cloudfront.net
AWS_S3_PREFIX=uploads/
AWS_S3_ACL=private
AWS_S3_ENCRYPTION=AES256

# Google Cloud Storage
GCS_PROJECT_ID=your-project-id
GCS_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour Private Key\n-----END PRIVATE KEY-----\n"
GCS_BUCKET_NAME=device-monitor-uploads

# --------------------------------------------
# LOGGING CONFIGURATION
# --------------------------------------------
LOG_LEVEL=info
LOG_DIR=logs
LOG_RETENTION_DAYS=30
LOG_MAX_SIZE=10485760
LOG_MAX_FILES=5
LOG_FORMAT=json
LOG_DATE_PATTERN=YYYY-MM-DD
LOG_COMPRESS=true
ERROR_LOG_FILE=error.log
COMBINED_LOG_FILE=combined.log
ACCESS_LOG_FILE=access.log

# --------------------------------------------
# MONITORING & ALERTS
# --------------------------------------------
# Device Monitoring
DEVICE_HEARTBEAT_INTERVAL=30000
DEVICE_TIMEOUT_MS=120000
DEVICE_OFFLINE_THRESHOLD=180000
DEVICE_CHECK_INTERVAL=30000
DEVICE_AUTO_CLEANUP=true
DEVICE_CLEANUP_DAYS=90

# Alert Thresholds
ALERT_CPU_THRESHOLD=80
ALERT_CPU_CRITICAL=90
ALERT_MEMORY_THRESHOLD=85
ALERT_MEMORY_CRITICAL=95
ALERT_BATTERY_THRESHOLD=20
ALERT_BATTERY_CRITICAL=10
ALERT_SIGNAL_THRESHOLD=30
ALERT_SIGNAL_CRITICAL=15
ALERT_DISK_THRESHOLD=90
ALERT_DISK_CRITICAL=95
ALERT_CHECK_INTERVAL=60000

# Data Retention
DATA_RETENTION_DAYS=30
KEYLOG_RETENTION_DAYS=30
LOCATION_HISTORY_DAYS=7
COMMAND_HISTORY_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365
NOTIFICATION_RETENTION_DAYS=30
ALERT_RETENTION_DAYS=90

# --------------------------------------------
# ADMIN CONFIGURATION
# --------------------------------------------
ADMIN_EMAIL=admin@devicemonitor.com
ADMIN_PASSWORD=Admin123!@#ChangeMe
ADMIN_NAME=System Administrator
ADMIN_PHONE=+1234567890
ADMIN_ROLE=super_admin

# --------------------------------------------
# ACTIVATION PIN CONFIGURATION
# --------------------------------------------
PIN_LENGTH=6
PIN_EXPIRY_MINUTES=5
PIN_MAX_ATTEMPTS=3
PIN_GENERATION_COOLDOWN=60

# --------------------------------------------
# WEBSOCKET CONFIGURATION
# --------------------------------------------
WS_PATH=/socket.io
WS_PING_INTERVAL=25000
WS_PING_TIMEOUT=20000
WS_TRANSPORTS=websocket,polling
WS_MAX_PAYLOAD=1048576
WS_CORS_ORIGIN=https://your-frontend.vercel.app

# --------------------------------------------
# MAINTENANCE MODE
# --------------------------------------------
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=We are currently performing scheduled maintenance. Please check back in 30 minutes.
MAINTENANCE_END_TIME=2024-01-01T00:00:00Z

# --------------------------------------------
# BACKUP CONFIGURATION
# --------------------------------------------
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=7
BACKUP_STORAGE=s3
BACKUP_COMPRESS=true
BACKUP_ENCRYPT=true
BACKUP_NOTIFY_ON_SUCCESS=true
BACKUP_NOTIFY_ON_FAILURE=true

# --------------------------------------------
# CACHE CONFIGURATION
# --------------------------------------------
CACHE_TTL=3600
CACHE_MAX_ITEMS=10000
CACHE_PREFIX=device_monitor
CACHE_ENABLED=true
CACHE_REDIS_TTL=86400
CACHE_MEMORY_TTL=300

# --------------------------------------------
# HEALTH CHECK
# --------------------------------------------
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_SUCCESS_THRESHOLD=2
HEALTH_CHECK_FAILURE_THRESHOLD=3
READINESS_CHECK_PATH=/ready
LIVENESS_CHECK_PATH=/live

# --------------------------------------------
# SSL/TLS CONFIGURATION
# --------------------------------------------
SSL_ENABLED=false
SSL_CERT_PATH=/etc/ssl/certs/server.crt
SSL_KEY_PATH=/etc/ssl/private/server.key
SSL_CA_PATH=/etc/ssl/certs/ca.crt
SSL_PORT=3443

# --------------------------------------------
# SECURITY HEADERS
# --------------------------------------------
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HSTS_PRELOAD=true
SECURITY_X_FRAME_OPTIONS=DENY
SECURITY_X_CONTENT_TYPE_OPTIONS=nosniff
SECURITY_X_XSS_PROTECTION=1; mode=block
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_PERMISSIONS_POLICY=camera=(), microphone=(), geolocation=(self)

# --------------------------------------------
# SESSION CONFIGURATION
# --------------------------------------------
SESSION_SECRET=your-session-secret-minimum-32-characters
SESSION_NAME=sessionId
SESSION_MAX_AGE=86400000
SESSION_RESAVE=false
SESSION_SAVE_UNINITIALIZED=false
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=lax

# --------------------------------------------
# API DOCUMENTATION
# --------------------------------------------
SWAGGER_ENABLED=true
SWAGGER_PATH=/api-docs
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=swagger123

# --------------------------------------------
# FEATURE FLAGS
# --------------------------------------------
FEATURE_SURVEILLANCE_ENABLED=true
FEATURE_REMOTE_COMMANDS_ENABLED=true
FEATURE_FILE_MANAGER_ENABLED=true
FEATURE_KEYLOGGER_ENABLED=true
FEATURE_CAMERA_ENABLED=true
FEATURE_MICROPHONE_ENABLED=true
FEATURE_LOCATION_TRACKING_ENABLED=true
FEATURE_SCREENSHOT_ENABLED=true
FEATURE_AUDIO_RECORDING_ENABLED=true
FEATURE_SMS_MANAGEMENT=true
FEATURE_CONTACT_SYNC=true
FEATURE_CALL_LOG_SYNC=true
FEATURE_REPORTING_ENABLED=true
FEATURE_EXPORT_ENABLED=true
FEATURE_WEBHOOKS_ENABLED=true

# --------------------------------------------
# DEBUG & DEVELOPMENT
# --------------------------------------------
DEBUG=false
DEBUG_NAMESPACE=app:*
VERBOSE_LOGGING=false
SHOW_STACK_TRACE=false
MOCK_EXTERNAL_SERVICES=false

# --------------------------------------------
# PERFORMANCE TUNING
# --------------------------------------------
MAX_PARALLEL_REQUESTS=100
REQUEST_TIMEOUT=30000
KEEP_ALIVE_TIMEOUT=65000
HEADERS_TIMEOUT=65000
BODY_LIMIT=50mb
PARAMETER_LIMIT=1000

# --------------------------------------------
# DATABASE BACKUP
# --------------------------------------------
MONGO_BACKUP_ENABLED=true
MONGO_BACKUP_SCHEDULE=0 1 * * *
MONGO_BACKUP_RETENTION=7
MONGO_BACKUP_PATH=/backups/mongodb

# --------------------------------------------
# PROMETHEUS METRICS
# --------------------------------------------
PROMETHEUS_ENABLED=true
PROMETHEUS_PATH=/metrics
PROMETHEUS_PORT=9090

# --------------------------------------------
# SENTRY ERROR TRACKING
# --------------------------------------------
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_RELEASE=3.0.0

# --------------------------------------------
# NEW RELIC MONITORING
# --------------------------------------------
NEW_RELIC_LICENSE_KEY=your-new-relic-key
NEW_RELIC_APP_NAME=DeviceMonitorBackend
NEW_RELIC_LOG_LEVEL=info

# --------------------------------------------
# ELASTIC APM
# --------------------------------------------
ELASTIC_APM_SERVER_URL=https://your-apm-server:8200
ELASTIC_APM_SECRET_TOKEN=your-secret-token
ELASTIC_APM_SERVICE_NAME=device-monitor-backend
ELASTIC_APM_ENVIRONMENT=production

# --------------------------------------------
# END OF CONFIGURATION
# --------------------------------------------
