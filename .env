# ============================================
# DEVICE MONITOR BACKEND - ENVIRONMENT VARIABLES
# ============================================
# Complete configuration for production deployment
# Version: 3.0.0
# ============================================

# --------------------------------------------
# SERVER CONFIGURATION
# --------------------------------------------
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
API_VERSION=v1
API_PREFIX=/api

# Frontend URL (for CORS)
FRONTEND_URL=https://your-frontend.vercel.app
FRONTEND_URL_LOCAL=http://localhost:3000

# --------------------------------------------
# DATABASE CONFIGURATION (MongoDB Atlas)
# --------------------------------------------
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/devicemonitor?retryWrites=true&w=majority
MONGODB_DB_NAME=device_monitor_prod
MONGODB_USER=your_db_user
MONGODB_PASSWORD=your_db_password

# --------------------------------------------
# REDIS CONFIGURATION (Upstash or Redis Cloud)
# --------------------------------------------
REDIS_URL=redis://:password@redis-host:6379
REDIS_HOST=your-redis-host.redis.cache.windows.net
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# --------------------------------------------
# JWT AUTHENTICATION
# --------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters
JWT_REFRESH_SECRET=your-refresh-secret-key-minimum-32-characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_DEVICE_EXPIRY=30d

# --------------------------------------------
# FIREBASE CONFIGURATION (FCM for Push Notifications)
# --------------------------------------------
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour Private Key\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# --------------------------------------------
# EMAIL CONFIGURATION (SMTP)
# --------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_SECURE=false
EMAIL_FROM=noreply@devicemonitor.com
EMAIL_FROM_NAME=Device Monitor Pro

# --------------------------------------------
# TWILIO CONFIGURATION (SMS & Calls)
# --------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --------------------------------------------
# WEBHOOKS & INTEGRATIONS
# --------------------------------------------
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your-webhook-url
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# --------------------------------------------
# SECURITY & ENCRYPTION
# --------------------------------------------
AES_SECRET_KEY=your-32-character-aes-encryption-key-here
AES_IV=your-16-character-iv
BCRYPT_ROUNDS=12
CSRF_SECRET=your-csrf-secret-key-minimum-32-characters

# --------------------------------------------
# RATE LIMITING
# --------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS_LOGIN=300000
RATE_LIMIT_MAX_REQUESTS_LOGIN=5
RATE_LIMIT_WINDOW_MS_API=60000
RATE_LIMIT_MAX_REQUESTS_API=50

# --------------------------------------------
# CORS CONFIGURATION
# --------------------------------------------
CORS_ORIGIN=https://your-frontend.vercel.app,http://localhost:3000
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-API-Key,X-Device-Id
CORS_CREDENTIALS=true

# --------------------------------------------
# DEVICE MONITORING CONFIGURATION
# --------------------------------------------
DEVICE_HEARTBEAT_INTERVAL=30000
DEVICE_TIMEOUT_MS=120000
DEVICE_OFFLINE_THRESHOLD=180000
DEVICE_CHECK_INTERVAL=30000

# Alert Thresholds
ALERT_CPU_THRESHOLD=80
ALERT_MEMORY_THRESHOLD=85
ALERT_BATTERY_THRESHOLD=20
ALERT_SIGNAL_THRESHOLD=30
ALERT_CHECK_INTERVAL=60000

# Data Retention
DATA_RETENTION_DAYS=30
KEYLOG_RETENTION_DAYS=30
LOCATION_HISTORY_DAYS=7
COMMAND_HISTORY_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365

# --------------------------------------------
# FILE UPLOAD CONFIGURATION
# --------------------------------------------
MAX_FILE_SIZE=52428800
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,video/mp4,audio/mpeg,application/pdf
UPLOAD_DIR=uploads
TEMP_DIR=temp

# --------------------------------------------
# LOGGING CONFIGURATION
# --------------------------------------------
LOG_LEVEL=info
LOG_DIR=logs
LOG_RETENTION_DAYS=30
LOG_MAX_SIZE=10485760
LOG_MAX_FILES=5

# --------------------------------------------
# ADMIN CONFIGURATION
# --------------------------------------------
ADMIN_EMAIL=admin@devicemonitor.com
ADMIN_PASSWORD=Admin123!@#ChangeMe
ADMIN_NAME=System Administrator
ADMIN_PHONE=+1234567890

# --------------------------------------------
# ACTIVATION PIN CONFIGURATION
# --------------------------------------------
PIN_LENGTH=6
PIN_EXPIRY_MINUTES=5
PIN_MAX_ATTEMPTS=3

# --------------------------------------------
# WEBSOCKET CONFIGURATION
# --------------------------------------------
WS_PATH=/socket.io
WS_PING_INTERVAL=25000
WS_PING_TIMEOUT=20000
WS_TRANSPORTS=websocket,polling

# --------------------------------------------
# MAINTENANCE MODE
# --------------------------------------------
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=We are currently performing maintenance. Please check back soon.

# --------------------------------------------
# BACKUP CONFIGURATION
# --------------------------------------------
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 0 * * *
BACKUP_RETENTION_DAYS=7
BACKUP_STORAGE=s3

# --------------------------------------------
# CACHE CONFIGURATION
# --------------------------------------------
CACHE_TTL=3600
CACHE_MAX_ITEMS=10000
CACHE_PREFIX=device_monitor

# --------------------------------------------
# HEALTH CHECK
# --------------------------------------------
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# --------------------------------------------
# SSL/TLS CONFIGURATION
# --------------------------------------------
SSL_ENABLED=false
SSL_CERT_PATH=/etc/ssl/certs
SSL_KEY_PATH=/etc/ssl/private

# --------------------------------------------
# END OF CONFIGURATION
# --------------------------------------------
