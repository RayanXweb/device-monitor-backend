{
  "name": "device-monitor-backend",
  "version": "3.0.0",
  "description": "Complete backend API for device monitoring system with surveillance features, real-time communication, and enterprise-grade security",
  "main": "src/app.js",
  "author": "Device Monitor Team",
  "license": "MIT",
  "keywords": [
    "device-monitoring",
    "surveillance",
    "remote-control",
    "real-time",
    "websocket",
    "iot",
    "security",
    "express",
    "mongodb",
    "redis",
    "socketio"
  ],
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "dev:debug": "nodemon --inspect src/app.js",
    "prod": "NODE_ENV=production node src/app.js",
    "prod:cluster": "NODE_ENV=production node src/cluster.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:e2e": "jest --testPathPattern=tests/e2e --runInBand",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,json,md}\"",
    "seed": "node scripts/seed.js",
    "seed:prod": "NODE_ENV=production node scripts/seed.js",
    "migrate": "node scripts/migrate.js",
    "migrate:down": "node scripts/migrate.js down",
    "cleanup": "node scripts/cleanup.js",
    "cleanup:logs": "node scripts/cleanup-logs.js",
    "vercel-build": "npm install && npm run build",
    "vercel-dev": "vercel dev",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker build -t device-monitor-backend .",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "docker-compose restart",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:monit": "pm2 monit",
    "build": "npm run lint && npm run test",
    "precommit": "lint-staged",
    "prepare": "husky install",
    "security:check": "npm audit",
    "security:fix": "npm audit fix",
    "update:deps": "npx npm-check-updates -u",
    "swagger": "node scripts/generate-swagger.js",
    "docs": "jsdoc -c jsdoc.json"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^8.0.3",
    "socket.io": "^4.5.4",
    "socket.io-client": "^4.5.4",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "express-session": "^1.17.3",
    "express-fileupload": "^1.4.3",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    
    "redis": "^4.6.11",
    "ioredis": "^5.3.2",
    "connect-redis": "^7.1.0",
    
    "firebase-admin": "^11.11.1",
    "nodemailer": "^6.9.7",
    "twilio": "^4.19.3",
    "agenda": "^5.0.0",
    "bull": "^4.11.5",
    "node-cron": "^3.0.3",
    "node-schedule": "^2.1.1",
    
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.1",
    "uuid": "^9.0.1",
    "crypto": "^1.0.1",
    "axios": "^1.6.2",
    "node-geocoder": "^4.2.0",
    "qs": "^6.11.2",
    "moment": "^2.29.4",
    "moment-timezone": "^0.5.43",
    "lodash": "^4.17.21",
    "joi": "^17.11.0",
    "yup": "^1.3.3",
    
    "json2csv": "^6.0.0",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.14.0",
    "ejs": "^3.1.9",
    "handlebars": "^4.7.8",
    
    "swagger-ui-express": "^5.0.0",
    "swagger-jsdoc": "^6.2.8",
    "jsdoc": "^4.0.2",
    
    "rate-limit-redis": "^4.0.0",
    "csrf": "^3.1.0",
    "xss": "^1.0.14",
    "sanitize-html": "^2.11.0",
    "validator": "^13.11.0",
    
    "os-utils": "^0.0.14",
    "systeminformation": "^5.21.22",
    "pidusage": "^3.0.2",
    
    "nodemon": "^3.0.2",
    "pm2": "^5.3.0",
    "forever": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/jest": "^29.5.11",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.14",
    "@types/uuid": "^9.0.7",
    
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "mongodb-memory-server": "^9.1.6",
    "@jest/globals": "^29.7.0",
    
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-security": "^1.7.1",
    "prettier": "^3.1.1",
    
    "faker": "^5.5.3",
    "fakerator": "^1.0.0",
    
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    
    "cross-env": "^7.0.3",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0",
    
    "nyc": "^15.1.0",
    "sinon": "^17.0.1",
    "proxyquire": "^2.1.3",
    "nock": "^13.4.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "os": ["linux", "darwin", "win32"],
  "cpu": ["x64", "arm64"],
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/RayanXweb/device-monitor-backend.git"
  },
  "bugs": {
    "url": "https://github.com/RayanXweb/device-monitor-backend/issues"
  },
  "homepage": "https://github.com/RayanXweb/device-monitor-backend#readme",
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/app.js",
      "!src/index.js",
      "!src/cluster.js",
      "!src/config/**",
      "!src/models/**"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFilesAfterEnv": ["./tests/setup.js"],
    "verbose": true,
    "forceExit": true,
    "clearMocks": true,
    "resetMocks": true,
    "restoreMocks": true,
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  },
  "lint-staged": {
    "src/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.json": [
      "prettier --write"
    ],
    "src/**/*.md": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm test"
    }
  },
  "nodemonConfig": {
    "watch": ["src"],
    "ext": "js,json",
    "ignore": ["src/**/*.test.js", "tests/**"],
    "delay": 2500,
    "env": {
      "NODE_ENV": "development"
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "lf"
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "jest": true,
      "es2021": true
    },
    "extends": [
      "eslint:recommended",
      "airbnb-base",
      "plugin:security/recommended"
    ],
    "parserOptions": {
      "ecmaVersion": 2021,
      "sourceType": "module"
    },
    "rules": {
      "no-console": "warn",
      "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
      "consistent-return": "off",
      "max-len": ["error", { "code": 120 }],
      "no-underscore-dangle": "off",
      "import/no-extraneous-dependencies": ["error", { "devDependencies": true }]
    }
  }
  }
